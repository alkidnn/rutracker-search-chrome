{
  "manifest_version": 3,
  "name": "Rutracker Search",
  "description": "Поиск на Rutracker из контекстного меню, popup и горячей клавишей",
  "version": "1.1",
"permissions": [
  "contextMenus",
  "tabs",
  "scripting",
  "activeTab"
],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Поиск на Rutracker",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon.png"
    }
  },
  "icons": {
    "32": "icon.png"
  },
  "commands": {
    "search-rutracker": {
      "suggested_key": {
        "default": "Ctrl+Shift+R"
      },
      "description": "Поиск выделенного текста на Rutracker"
    }
  }
}
